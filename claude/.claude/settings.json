{
  "cleanupPeriodDays": 360,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/claude-notify.py"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head",
    "bgIsolation": "worktree"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "spellcheck": {
    "enabled": true,
    "language": "en_US"
  },
  "autoCompactWindow": 250000,
  "tui": "default",
  "theme": "dark",
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": true
}
