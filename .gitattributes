# Ensure install.sh is executable when checked out on Linux/macOS
install.sh eol=lf
install.sh diff=shell

# Normalize baked-in /home/<user>/ absolute paths to a placeholder on commit,
# re-expand to this machine's $HOME on checkout — see git-filters/*.sh.
# Only config.kdl needs this: it's static KDL data read by zjstatus's WASM
# plugin, which (like the file itself, symlinked straight into $HOME) has no
# ~/$HOME expansion of its own. Neovim's equivalent (autocmds.lua) is Lua, so
# it computes the same path at runtime with vim.fn.expand() instead.
zellij/.config/zellij/config.kdl filter=homepath

# Force LF line endings for all shell scripts and config files
*.sh       eol=lf
*.zsh      eol=lf
*.toml     eol=lf
*.kdl      eol=lf
*.yaml     eol=lf
*.yml      eol=lf
*.lua      eol=lf
*.toml     eol=lf
*.conf     eol=lf
config     eol=lf
ripgreprc  eol=lf
.gitconfig eol=lf
.gitignore_global eol=lf
